# Gemini API key for the optional "Improve with AI" buttons
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: prefill the login form (only for a dashboard running on your own computer)
LOGIN_EMAIL=
LOGIN_PASSWORD_PREFILL=

# Cloudflare Turnstile site key used by WorkOwon login (public). Defaults to WorkOwon's key.
# Add this JobSync hostname (e.g. jobsync-wgs9.onrender.com and localhost) to that widget's allowed hostnames.
TURNSTILE_SITE_KEY=

# Command-line poster only (post_jobs.py); the dashboard logs in with email/password instead
WORKOWON_TOKEN=
POST_LIMIT=5
