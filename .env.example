# Gemini API key for the optional "Improve with AI" buttons
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: prefill the login form (only for a dashboard running on your own computer)
LOGIN_EMAIL=
LOGIN_PASSWORD_PREFILL=

# Cloudflare Turnstile site key used by WorkOwon login (public only — secret stays on WorkOwon).
# Defaults to WorkOwon's key. Add this JobSync hostname to that widget's allowed hostnames.
TURNSTILE_SITE_KEY=0x4AAAAAAF8mwjtmsgdq3yaK
# Alias accepted too (same public key):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAF8mwjtmsgdq3yaK

# Command-line poster only (post_jobs.py); the dashboard logs in with email/password instead
WORKOWON_TOKEN=
POST_LIMIT=5
